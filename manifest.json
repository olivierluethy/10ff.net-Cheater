{
  "manifest_version": 3,
  "name": "10ff.net Cheater",
  "version": "1.0.0",
  "description": "A Chrome extension to cheat on 10ff.net and become as fast as possible.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://10ff.net/*"],
      "js": ["main.js"]
    }
  ]
}
